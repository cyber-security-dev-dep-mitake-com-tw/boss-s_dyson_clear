{
  "name": "@sweepdeck/app",
  "version": "0.1.0",
  "private": true,
  "description": "SweepDeck — Electron app (main / preload / React renderer)",
  "productName": "SweepDeck",
  "main": "./out/main/index.js",
  "scripts": {
